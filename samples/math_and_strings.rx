func main() {
    name := "RustX Starter"
    upperName := to_upper(name)
    println("Language:", upperName)

    if contains(upperName, "RUSTX") {
        println("Language initialized successfully!")
    }

    var total = 0
    for i := 1; i <= 5; i++ {
        total = total + i
    }
    println("Sum 1..5 =", total)

    powRes := pow(2, 4)
    println("2^4 =", powRes)
}
