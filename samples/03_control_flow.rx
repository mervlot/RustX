func main() {
    name := "RustX"

    if name == "RustX" {
        println("Language initialized successfully!")
    }

    println("Counting with for loop:")
    for i := 0; i < 5; i++ {
        println("  i =", i)
    }

    println("Counting with while loop:")
    count := 3
    while count > 0 {
        println("  count =", count)
        count--
    }
}
