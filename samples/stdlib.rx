func main() {
    msg := "Hello, RustX Starter!"
    println("Original:", msg)
    println("Upper:", to_upper(msg))
    println("Lower:", to_lower(msg))
    println("Length:", len(msg))

    arr := [10, 20, 30]
    println("Array length:", len(arr))

    println("Absolute of -42:", abs(-42))
    println("2^10:", pow(2, 10))

    file_path := "test_out.txt"
    write_file(file_path, "RustX filesystem stdlib works!")
    content := read_file(file_path)
    println("Read from file:", content)
}
