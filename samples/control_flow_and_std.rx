name := "RustX Starter"

if name == "RustX Starter" {
    println("Language initialized successfully.")
} else {
    println("Unknown language.")
}

var sum = 0
for i := 0; i < 5; i++ {
    sum = sum + i
}

println("Sum of numbers from 0 to 4 is:", sum)

