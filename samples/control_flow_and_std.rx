func main() {
    name := "RustX Starter"
    println("Welcome to", name)

    var sum = 0
    for i := 1; i <= 10; i++ {
        sum = sum + i
    }
    println("Sum of numbers 1 to 10 is:", sum)

    numbers := [10, 20, 30, 40]
    println("Array length:", len(numbers))
    println("Element at index 2:", numbers[2])

    // String builtins demo
    msg := "hello rustx"
    println("Upper:", to_upper(msg))
    println("Contains 'rustx':", contains(msg, "rustx"))
}
