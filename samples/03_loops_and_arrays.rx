func main() {
    println("--- Loops and Arrays ---")
    var sum = 0
    for i := 1; i <= 10; i++ {
        sum = sum + i
    }
    println("Sum 1..10 =", sum)

    arr := [10, 20, 30, 40, 50]
    println("Array length =", len(arr))
    for idx := 0; idx < len(arr); idx++ {
        println("arr[", idx, "] =", arr[idx])
    }
}
