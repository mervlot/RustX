func main() {
    name := "RustX Starter"
    var version float = 0.1

    if name == "RustX Starter" {
        println("Language:", name)
        println("Version:", version)
    }

    var sum = 0
    for i := 1; i <= 10; i++ {
        sum = sum + i
    }
    println("Sum of numbers 1 to 10 is:", sum)

    message := "hello rustx"
    println("Upper:", to_upper(message))
    println("Contains 'rust':", contains(message, "rust"))

    println("Absolute of -42:", abs(-42))
    println("2^10 = ", pow(2, 10))
}
