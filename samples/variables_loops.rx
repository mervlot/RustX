func main() {
    name := "RustX"
    var age int = 1

    if name == "RustX" {
        println("Language initialized:", name)
    }

    println("Counting using for loop:")
    for i := 0; i < 5; i++ {
        println("i =", i)
    }

    println("Counting down using while loop:")
    count := 3
    while count > 0 {
        println("count =", count)
        count--
    }

    println("String uppercase:", to_upper(name))
