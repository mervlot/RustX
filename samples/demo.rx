func main() {
    println("--- Variables & Types ---")
    var age = 16
    name := "RustX Starter"
    println("Name:", name, "| Age:", age)

    println("\n--- Control Flow (Loops & If/Else) ---")
    sum := 0
    for i := 1; i <= 5; i++ {
        sum = sum + i
    }
    println("Sum of 1..5:", sum)

    if sum == 15 {
        println("Sum check passed!")
    } else {
        println("Sum check failed!")
    }

    println("\n--- Standard Library Built-ins ---")
    msg := "Hello, World!"
    println("Length of msg:", len(msg))
    println("Uppercase:", to_upper(msg))
    println("Contains 'World':", contains(msg, "World"))
    println("Absolute value of -42:", abs(-42))
}
