func main() {
    name := "RustX"

    if name == "RustX" {
        println("Language initialized successfully!")
    }

    var numbers = [10, 20, 30, 40]
    println("Numbers array length:", len(numbers))

    var sum = 0
    for i := 0; i < len(numbers); i++ {
        sum = sum + numbers[i]
    }
    println("Sum of elements:", sum)

    message := "rustx starter language"
    println("Uppercase message:", to_upper(message))
}
