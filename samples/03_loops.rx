func main() {
    println("--- For Loop ---")
    sum := 0
    for i := 0; i < 5; i++ {
        println("i =", i)
        sum = sum + i
    }
    println("Sum =", sum)

    println("--- While Loop ---")
    countdown := 3
    while countdown > 0 {
        println("T-minus", countdown)
        countdown--
    }
    println("Liftoff!")
}
