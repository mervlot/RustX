func main() {
    name := "RustX"

    if name == "RustX" {
        println("Language initialized successfully.")
    } else {
        println("Unknown language.")
    }

    println("Counting from 0 to 4 using for loop:")
    for i := 0; i < 5; i++ {
        println("i =", i)
    }

    println("Counting down using while loop:")
    count := 3
    while count > 0 {
        println("count =", count)
        count--
    }
}
