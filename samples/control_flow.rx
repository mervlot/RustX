func main() {
    println("--- For Loop ---")
    var sum = 0
    for i := 1; i <= 5; i++ {
        sum = sum + i
        println("i:", i, "sum:", sum)
    }

    println("--- While Loop ---")
    var count = 3
    while count > 0 {
        println("Countdown:", count)
        count--
    }

    println("--- If / Else ---")
    score := 85
    if score >= 90 {
        println("Grade: A")
    } else if score >= 80 {
        println("Grade: B")
    } else {
        println("Grade: C")
    }
}
