func main() {
    name := "RustX"

    if name == "RustX" {
        println("Language initialized successfully!")
    }

    // Numbers & Loops
    var total int = 0
    for i := 1; i <= 10; i++ {
        total = total + i
    }
    println("Sum of 1..10 is:", total)

    // Standard Library Functions
    greeting := "hello world"
    println("Upper:", to_upper(greeting))
    println("Contains 'world':", contains(greeting, "world"))

    // Math
    println("2^10 = ", pow(2, 10))
    println("abs(-42) = ", abs(-42))
}
