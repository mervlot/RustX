// Variables, arithmetic, and control flow in RustX
var x = 10
y := 20

println("Initial x:", x, "y:", y)

if x < y && y == 20 {
    println("Condition met: x < y and y is 20")
} else {
    println("Condition not met")
}

// For loop
sum := 0
for i := 1; i <= 5; i++ {
    sum = sum + i
}
println("Sum 1..5 is:", sum)

// While loop
count := 3
while count > 0 {
    println("Counting down:", count)
    count--
}
println("Liftoff!")
