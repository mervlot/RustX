func main() {
    name := "RustX"

    if name == "RustX" {
        println("Language initialized successfully!")
    }

    nums := [10, 20, 30]
    println("Array len:", len(nums))
    println("First element:", nums[0])

    sum := 0
    for i := 0; i < len(nums); i++ {
        sum = sum + nums[i]
    }
    println("Sum of elements:", sum)

    message := "RustX Starter Language"
    println("Upper:", to_upper(message))
    println("Contains 'Starter':", contains(message, "Starter"))
}
