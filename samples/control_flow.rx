func main() {
    name := "RustX"

    if name == "RustX" {
        println("Language initialized:", name)
    } else {
        println("Unknown language")
    }

    println("Counting to 5 with for loop:")
    for i := 1; i <= 5; i++ {
        println("i =", i)
    }

    println("Countdown with while loop:")
    var count = 3
    while count > 0 {
        println("count =", count)
        count--
    }
}
