func main() {
    println("--- For Loop Demo ---")
    var sum = 0
    for i := 1; i <= 5; i++ {
        println("i =", i)
        sum = sum + i
    }
    println("Sum:", sum)

    println("--- While Loop Demo ---")
    count := 3
    while count > 0 {
        println("Count down:", count)
        count--
    }
    println("Blast off!")
}
