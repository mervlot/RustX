func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

println("Factorial of 5 is:", factorial(5))

name := "RustX"
println("Name is:", name)
if name == "RustX" {
    println("Language initialized correctly")
} else {
    println("This should not happen")
}

for i := 0; i < 5; i++ {
    println("Iteration:", i)
}

counter := 0
while counter < 3 {
    println("While counter:", counter)
    counter++
}
