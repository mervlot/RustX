func factorial(n int) int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

println("Factorial of 5 is:", factorial(5))

x := 10
if x > 5 && x < 15 {
    println("x is between 5 and 15")
}

